# Auto detect text files and normalize line endings to LF
* text=auto

# Text files
*.txt text eol=lf
*.md text eol=lf
*.markdown text eol=lf
*.mdown text eol=lf
*.mkdn text eol=lf
*.mkd text eol=lf
*.rdoc text eol=lf

# Code files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.maven text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.com text eol=crlf

# Shell scripts should have LF
*.sh text eol=lf

# Document files
*.doc diff=word
*.docx diff=word
*.pdf diff=pdf
*.odt diff=odt
*.rtf diff=rtf

# Image files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.eps binary
*.webp binary
*.mp4 binary
*.mov binary
*.mp3 binary
*.wav binary
*.zip binary
*.7z binary
*.rar binary
*.gz binary
*.tar binary
*.bz2 binary
*.xz binary

# Archive files
*.jar binary
*.zip binary
*.tar binary
*.tar.gz binary
*.tar.bz2 binary
*.tgz binary

# Font files
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Compiled files
*.com binary
*.class binary
*.dll binary
*.exe binary
*.o binary
*.so binary
*.out binary

# Git files
.gitattributes text eol=lf
.gitignore text eol=lf
.gitkeep text eol=lf

# Project files
.editorconfig text eol=lf
.eslintrc* text eol=lf
.prettierrc* text eol=lf
.npmrc text eol=lf
.nvmrc text eol=lf
.ruby-version text eol=lf
.python-version text eol=lf

# License and documentation
LICENSE text eol=lf
README* text eol=lf
CHANGELOG* text eol=lf
AUTHORS text eol=lf
CONTRIBUTORS text eol=lf
INSTALL* text eol=lf
NEWS text eol=lf
HISTORY text eol=lf
NOTICE text eol=lf
CHANGES text eol=lf
